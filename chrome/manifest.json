{
  "manifest_version": 3,
  "name": "crab-band",
  "version": "0.1.0",
  "description": "Pixel crabs that dance while Claude answers on claude.ai. Unofficial: not made or endorsed by Anthropic.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
